# Cadena de conexión a PostgreSQL (local, pgAdmin o Neon)
# Local:  postgresql://postgres:TU_CONTRASENA@localhost:5432/ducky
# Neon:   postgresql://usuario:password@host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:TU_CONTRASENA@localhost:5432/ducky

# true solo si la base está en la nube (Neon, Render, etc.)
DB_SSL=false

# Puerto del servidor
PORT=3000

# Llave propia de al menos 32 caracteres para firmar las sesiones
SESSION_SECRET=cambia-esta-llave-por-una-propia

# Recuperación por Resend (solo servidor; vacíos mantienen el servicio deshabilitado)
RESEND_API_KEY=
RECOVERY_FROM=
APP_PUBLIC_URL=
# Secreto aleatorio independiente de SESSION_SECRET, mínimo 32 caracteres
RECOVERY_SECRET=

# Solo para pruebas en esta computadora (en producción mantener false y usar HTTPS)
# NODE_ENV=development
# APP_PUBLIC_URL=http://localhost:3001
RECOVERY_ALLOW_LOCALHOST=false
