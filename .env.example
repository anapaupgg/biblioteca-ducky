# Cadena de conexión a PostgreSQL (local, pgAdmin o Neon)
# Local:  postgresql://postgres:TU_CONTRASENA@localhost:5432/ducky
# Neon:   postgresql://usuario:password@host.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ducky

# true solo si la base está en la nube (Neon, Render, etc.)
DB_SSL=false

# Puerto del servidor
PORT=3000

# Llave para firmar los tokens de sesión (cámbiala por cualquier texto largo)
SESSION_SECRET=cambia-esta-llave-por-una-propia
